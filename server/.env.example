# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Port the server listens on
PORT=3000

# Full public URL of this server (no trailing slash).
# Used to build OAuth callback URLs. For local dev with a tunnel (see README)
# this will be your ngrok/tunnel URL, not localhost.
APP_BASE_URL=http://127.0.0.1:3000

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# ---------------------------------------------------------------------------
# X (Twitter) Developer Portal -> your Project -> your App -> "Keys and tokens"
# App must be set to OAuth 2.0, type "Web App, Automated App or Bot",
# with a Callback URI of:  {APP_BASE_URL}/auth/callback
# ---------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — only needed for "Set as X profile picture".
# The account/update_profile_image endpoint is a legacy v1.1 endpoint that
# requires OAuth 1.0a *and*, per X's current pricing, at least the paid
# Basic tier (the free / pay-per-use tier does not include v1.1 access).
# Leave these blank to disable the profile-picture feature entirely —
# posting to X (above) works without them.
#
# Found under the same App -> "Keys and tokens" -> "Consumer Keys"
# (these are the "API Key" / "API Key Secret", NOT the OAuth2 client id/secret)
# ---------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
